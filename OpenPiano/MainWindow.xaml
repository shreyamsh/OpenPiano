<Window
    x:Class="OpenPiano.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Open Piano">
    <Grid Padding="24" RowDefinitions="Auto,*">
        <TextBlock Text="Open Piano" Style="{StaticResource TitleTextBlockStyle}" />
        <!-- Keys are generated in code-behind (white keys first, black keys layered on top). -->
        <Canvas x:Name="KeyboardCanvas" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Window>
